# Copy this file to .env and fill in your values.

# From https://developer.yahoo.com/apps/ -> Create an App
# - Redirect URI(s): https://localhost:8080  (must match YAHOO_REDIRECT_URI below exactly)
# - OAuth Client Type: Confidential Client
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=

# Only needed if you registered a different Redirect URI above.
# YAHOO_REDIRECT_URI=https://localhost:8080

# Your league's numeric Yahoo league ID (the part after "l." in a league URL,
# e.g. https://football.fantasysports.yahoo.com/f1/123456 -> 123456).
# This stays constant across seasons; the league_key (game_key.l.league_id)
# changes every year and is resolved automatically by `draft-helper leagues`.
YAHOO_LEAGUE_ID=

# League auction budget per team, used for inflation math.
LEAGUE_BUDGET=200
